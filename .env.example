# Salin file ini menjadi .env untuk development lokal.
# Di Render, isi variabel yang sama lewat menu Environment (JANGAN commit .env ke GitHub).

# URL aplikasi (dipakai untuk link check-in di email), tanpa garis miring di akhir
APP_URL=http://localhost:8000

# --- Firebase (Project settings > General > Your apps > Web app) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=nama-project.firebaseapp.com
FIREBASE_PROJECT_ID=nama-project
FIREBASE_DATABASE_URL=https://nama-project-default-rtdb.asia-southeast1.firebasedatabase.app

# Service account (Project settings > Service accounts > Generate new private key)
# Isi dengan PATH file JSON-nya. Di Render: upload sebagai Secret File, lalu isi /etc/secrets/firebase.json
FIREBASE_CREDENTIALS=./firebase-credentials.json

# --- Resend (https://resend.com/api-keys) ---
RESEND_API_KEY=
# Tanpa domain terverifikasi, Resend hanya bisa mengirim ke email pemilik akun Resend.
MAIL_FROM=RoomSync Cloud <onboarding@resend.dev>

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Opsional: kunci untuk endpoint /cron.php (min. 16 karakter acak). Kosongkan untuk menonaktifkan.
CRON_SECRET=
